# ==============================================================================
# FleetGuard Pulse - Local Development Environment Configuration (.env.example)
# Copy this file to .env for local overrides. Do NOT commit real secrets.
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL 16 (with pgvector)
# (Port 5433 avoids collision with default host PostgreSQL instances)
# ------------------------------------------------------------------------------
POSTGRES_USER=fleetguard_user
POSTGRES_PASSWORD=fleetguard_dev_password
POSTGRES_DB=fleetguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# MongoDB 7 (Raw Telemetry Archive)
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=fleetguard_user
MONGO_INITDB_ROOT_PASSWORD=fleetguard_dev_password
MONGO_DB=fleetguard_telemetry
MONGO_HOST=localhost
MONGO_PORT=27017

# ------------------------------------------------------------------------------
# Redis 7 (Hot State & Dedup Cache)
# (Port 6380 avoids collision with default host Redis instances)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# ClickHouse (Columnar Batch Analytics)
# ------------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=fleetguard_dev_password
CLICKHOUSE_DB=fleetguard_analytics
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ------------------------------------------------------------------------------
# Redpanda (Kafka-Compatible Messaging Broker)
# ------------------------------------------------------------------------------
REDPANDA_HOST=localhost
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_REGISTRY_PORT=8081

# ------------------------------------------------------------------------------
# Application Service Ports (Future implementation)
# ------------------------------------------------------------------------------
API_PORT=8000
INGESTION_PORT=8001
FRONTEND_PORT=3000
METRICS_PORT=9090
