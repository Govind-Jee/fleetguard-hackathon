# FleetGuard Pulse Frontend Environment Configuration Example
# Copy to frontend/.env for local development (frontend/.env is git-ignored)

# API Base URL (defaults to /api which Vite proxies to backend in dev)
VITE_API_BASE_URL=/api

# WebSocket Server URL (defaults to current host /ws/alerts)
VITE_WS_URL=

# Local Development JWT Token
# Generate a fresh 8-hour development token via:
# python3 scripts/generate_dev_token.py --write-frontend-env
VITE_AUTH_TOKEN=
